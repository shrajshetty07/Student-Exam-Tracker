# Copy this file to ".env" and adjust values as needed.

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-in-production
PORT=5000

# Database engine: "sqlite" (default, zero-config) or "mysql" (production)
DB_ENGINE=sqlite

# Only required when DB_ENGINE=mysql
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=student_tracker

# Default admin account seeded automatically on first run
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_EMAIL=admin@school.edu
